{
  "name": "@2wav/markdown-track",
  "version": "0.1.0",
  "description": "A Vue 3 component suite to manage markdown file collaboration.",
  "type": "module",
  "license": "LGPL-3.0-or-later",
  "author": "Anderson Wiese <anderson@2wav.io>",
  "homepage": "https://github.com/anderson-2wav/markdown-track#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anderson-2wav/markdown-track.git"
  },
  "bugs": {
    "url": "https://github.com/anderson-2wav/markdown-track/issues"
  },
  "keywords": ["vue", "vue3", "markdown", "collaboration", "editor", "component-library", "bold"],
  "files": ["dist", "index.d.ts"],
  "module": "./src/index.js",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.js"
    },
    "./style.css": "./src/styles/markdown-track.css"
  },
  "sideEffects": ["**/*.css"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config vite.lib.config.mjs",
    "build": "vite build --config vite.lib.config.mjs",
    "prepublishOnly": "npm run build",
    "test": "node --test"
  },
  "dependencies": {
    "@kangc/v-md-editor": "^2.3.18",
    "@tiptap/vue-3": "^2.5.1",
    "@tiptap/starter-kit": "^2.5.1",
    "@tiptap/extension-link": "^2.5.1",
    "tiptap-markdown": "^0.8.10",
    "marked": "^16.4.1",
    "marked-gfm-heading-id": "^4.1.4",
    "highlight.js": "^11.11.1",
    "diff": "^8.0.3",
    "d3-scale": "^4.0.2"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "mermaid": "^11.12.1"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "jsdom": "^29.0.0"
  }
}
